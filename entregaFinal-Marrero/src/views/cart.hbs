<h1>Carrito: {{cart._id}}</h1>

{{#if cart.products.length}}
    <table border="1">
        <thead>
            <tr>
                <th>id</th>
                <th>Product</th>
                <th>Description</th>
                <th>Price</th>
                <th>Category</th>
                <th>Quantity</th>
            </tr>
        </thead>
        <tbody>
            {{#each cart.products}}
                <tr>
                     <td>{{this._id}}</td>
                    <td>{{this.product.title}}</td>
                    <td>{{this.product.description}}</td>
                    <td>{{this.product.price}}</td>
                    <td>{{this.product.category}}</td>
                    <td>{{this.quantity }}</td>
                </tr>
            {{/each}}
        </tbody>
    </table>
{{else}}
    <p>No hay productos en este carrito.</p>
{{/if}}
