<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css">
    <style>
        /* Estilos generales para todas las páginas */
        body {
            background-color: #f5f5f5;
            font-family: 'Arial', sans-serif;
        }

        .page-header {
            background: linear-gradient(45deg, #2196F3, #64B5F6);
            color: white;
            padding: 2rem;
            margin-bottom: 2rem;
            border-radius: 8px;
            text-align: center;
        }

        .content-section {
            background: white;
            padding: 2rem;
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            margin-bottom: 2rem;
        }

        /* Estilos para formularios */
        .filters-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.5rem;
            margin-bottom: 1rem;
        }

        .input-field {
            margin-bottom: 20px;
            position: relative;
            display: flex;
            flex-direction: column;
        }

        .input-field label {
            display: block;
            margin-bottom: 8px;
            font-size: 14px;
            color: #333;
            position: relative;
            /* Eliminar cualquier estilo de transformación que pueda causar superposición */
            transform: none !important;
        }

        .input-field input,
        .input-field select {
            width: 100%;
            padding: 8px;
            border: 1px solid #ddd;
            border-radius: 4px;
            height: 36px;
            margin-top: 5px;
            /* Asegurar que el input esté por encima del label */
            position: relative;
            background: white;
        }

        /* Contenedor específico para los carritos */
        .carts-container {
            margin-top: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .carts-container label {
            margin-bottom: 0;
            flex-shrink: 0;
        }

        /* Sobrescribir estilos de Materialize que puedan causar conflictos */
        .input-field > label:not(.label-icon).active {
            transform: none;
            position: relative;
        }

        /* Asegurar que los selects tengan el estilo correcto */
        select {
            display: block !important;
            position: relative !important;
            opacity: 1 !important;
            pointer-events: auto !important;
        }

        /* Ajustes adicionales para el grid de filtros */
        .filters-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 2rem;
            margin-bottom: 2rem;
            align-items: start;
        }

        /* Ajustes para el botón Apply */
        .actions-container {
            display: flex;
            justify-content: flex-end;
            margin-top: 1rem;
            align-items: flex-end;
            height: 100%;
        }

        /* Asegurar que los inputs de tipo number no tengan flechas superpuestas */
        input[type="number"] {
            -moz-appearance: textfield;
        }

        input[type="number"]::-webkit-outer-spin-button,
        input[type="number"]::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }


        /* Estilos para tablas */
        table {
            width: 100%;
            background: white;
            border-radius: 8px;
            overflow: hidden;
            margin: 1rem 0;
        }

        table thead {
            background: #64B5F6;
            color: white;
        }

        table th, 
        table td {
            padding: 1rem;
            text-align: left;
        }

        table tbody tr:nth-child(even) {
            background: #f5f5f5;
        }

        /* Estilos para botones */
        .btn-custom {
            background-color: #2196F3;
            color: white;
            padding: 0.5rem 1rem;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            transition: background-color 0.3s ease;
            margin: 0.5rem;
        }

        .btn-custom:hover {
            background-color: #1976D2;
        }

        /* Estilos para selects e inputs */
        select.browser-default,
        input.browser-default {
            width: 100%;
            padding: 0.5rem;
            border: 1px solid #ddd;
            border-radius: 4px;
            background: white;
            height: 2.5rem;
        }

        /* Estilos para contenedores de acciones */
        .actions-container {
            display: flex;
            gap: 1rem;
            justify-content: flex-end;
            margin-top: 0rem; /* Reduce el espacio superior */
        }


        /* Estilos para mensajes y alertas */
        .alert {
            padding: 1rem;
            border-radius: 4px;
            margin: 1rem 0;
        }

        .alert-success {
            background-color: #C8E6C9;
            color: #2E7D32;
        }

        .alert-error {
            background-color: #FFCDD2;
            color: #C62828;
        }

        /* Responsive container */
        .container {
            width: 95%;
            max-width: 1200px;
            margin: 0 auto;
            padding: 1rem;
        }

        /* Estilos para cards */
        .card {
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

        .card-content {
            padding: 1.5rem;
        }

        /* Utilidades */
        .text-center {
            text-align: center;
        }

        .mb-2 {
            margin-bottom: 2rem;
        }

        .mt-2 {
            margin-top: 2rem;
        }
    </style>
</head>
<body>
    <div class="container">
        {{{ body }}}
    </div>
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
</body>
</html>